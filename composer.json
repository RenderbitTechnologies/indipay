{
    "name": "softon/indipay",
    "description": "A Laravel 5.6 to 12 package for Indian payment gateways: CCAvenue, PayUMoney, EBS, CitrusPay, InstaMojo, ZapakPay, Paytm, Mocker.",
    "license": "MIT",
    "keywords": [
        "Laravel",
        "Indian Payment Gateways",
        "CCAvenue",
        "PayUMoney",
        "EBS",
        "CitrusPay",
        "InstaMojo",
        "Mobikwik",
        "ZapakPay",
        "Paytm",
        "Mocker"
    ],
    "authors": [
        {
            "name": "Shiburaj",
            "email": "powerupneo@gmail.com"
        }
    ],
    "require": {
        "php": "^7.1.3|^8.0",
        "illuminate/support": "~5.6.0|~5.7.0|~5.8.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "~6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Softon\\Indipay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softon\\Indipay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Softon\\Indipay\\IndipayServiceProvider"
            ],
            "aliases": {
                "Indipay": "Softon\\Indipay\\Facades\\Indipay"
            }
        }
    },
    "minimum-stability": "dev",
    "scripts": {
        "test": "phpunit"
    }
}
